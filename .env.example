# Bring your own key. Put ONE key below; the first one found is used
# (order: OpenAI, Anthropic, Gemini, Mistral, Groq, OpenRouter, Langdock, custom).
# Or pick explicitly with LLM_PROVIDER=openai|anthropic|gemini|mistral|groq|openrouter|ollama|langdock|custom
LLM_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Langdock (OpenAI-compatible, UNTESTED): set LLM_BASE_URL to your Langdock OpenAI-compatible URL
LANGDOCK_API_KEY=
# Any other OpenAI-compatible endpoint: LLM_PROVIDER=custom + LLM_API_KEY + LLM_BASE_URL
LLM_API_KEY=
LLM_BASE_URL=
# Optional model override (otherwise each provider's default; or pass --model=...)
LLM_MODEL=
# OPENAI_BASE_URL still works for the openai provider (backwards compatible)
# Set to 0 to never send temperature (gpt-5* / o* models are detected automatically)
# LLM_SEND_TEMPERATURE=0
